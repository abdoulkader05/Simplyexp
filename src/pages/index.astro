---
// Accueil : promesse, chemin en quatre étapes, points d'entrée, domaines et parcours.
import Base from '../layouts/Base.astro';
import { corriger } from '../lib/rehype-typo-fr.mjs';
import { ETAGES, scinder, fichesEcrites, conceptsDu, urlDomaine, urlParcours, concepts, domaines, parcours, urlConcept } from '../lib/site';

const ecrites = await fichesEcrites();
const total = concepts.size;
const nbEcrites = [...concepts.keys()].filter((id) => ecrites.has(id)).length;
const etages = ETAGES.map((e) => {
  const doms = e.domaines.map((id) => {
    const liste = conceptsDu(id);
    const [titre, sous] = scinder(domaines.get(id)!.titre);
    return { id, titre, sous, total: liste.length, ecrites: liste.filter((c) => ecrites.has(c.id)).length };
  });
  return { ...e, doms, total: doms.reduce((s, d) => s + d.total, 0), ecrites: doms.reduce((s, d) => s + d.ecrites, 0) };
});
const lien = (id: string) => urlConcept(concepts.get(id)!);
const ENTREES = [
  { titre: 'Je pars de zéro', texte: 'Une fonction, une dérivée, un vecteur : on reprend les bases, sans rien supposer.', href: lien('fonctions'), action: 'Commencer par les fonctions' },
  { titre: 'J’ai des bases en maths', texte: 'Passe directement au premier modèle qui apprend : la régression linéaire.', href: lien('regression-lineaire'), action: 'Voir la régression linéaire' },
  { titre: 'Je veux comprendre ChatGPT', texte: 'Un parcours complet, dans l’ordre, jusqu’au fonctionnement d’un assistant.', href: urlParcours('comment-marche-chatgpt'), action: 'Suivre le parcours' },
];
const ANATOMIE = [
  { titre: 'L’idée en une phrase', texte: 'Avant tout calcul, ce qu’il faut retenir.' },
  { titre: 'Une animation qui explique', texte: 'On fait défiler, le calcul se construit sous tes yeux.' },
  { titre: 'Des formules démontrées', texte: 'Chaque symbole défini, un exemple à la main, la preuve dépliable.' },
  { titre: 'Du code qui tourne', texte: 'En Python, depuis zéro, puis avec la bibliothèque qu’on utilise en vrai.' },
  { titre: 'Des exercices et un quiz', texte: 'Des situations concrètes à résoudre, corrigé compris.' },
];
const pct = (a: number, b: number) => (b ? Math.round((100 * a) / b) : 0);
---
<Base titre="Apprendre l’IA, des maths aux LLM" description="Un cours d’IA en français, en fiches reliées : des fonctions et des vecteurs jusqu’aux transformers, aux LLM et aux agents.">
  <main id="contenu">
    <section class="heros">
      <div class="heros-texte">
        <p class="surtitre">Cours d’IA en français</p>
        <h1>Comprendre l’IA pour de vrai, des maths jusqu’aux LLM</h1>
        <p class="chapo">{corriger(`Des fiches courtes et reliées entre elles : chacune démontre ses formules, anime ses calculs et renvoie à ce qu’il faut savoir avant. Tu avances à ton rythme, de la notion de fonction jusqu’aux agents.`)}</p>
        <div class="actions">
          <a class="bouton bouton-plein" href={lien('fonctions')}>Commencer au début</a>
          <a class="bouton" href="/parcours/">Choisir un parcours</a>
        </div>
        <p class="chiffres"><strong>{nbEcrites}</strong> fiches écrites sur {total} prévues · {domaines.size} domaines · {parcours.length} parcours</p>
      </div>

      <ol class="route" aria-label="Le chemin, en quatre étapes">
        {etages.map((e, i) => (
          <li>
            <a href={`#etage-${e.id}`}>
              <span class="route-num">{i + 1}</span>
              <span class="route-titre">{e.titre}</span>
              <span class="route-resume">{e.resume}</span>
              <span class="route-compte">{e.ecrites} / {e.total} fiches</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="bande" aria-labelledby="titre-entrees">
      <div class="dedans">
        <h2 id="titre-entrees">Par où commencer ?</h2>
        <div class="entrees">
          {ENTREES.map((e) => (
            <a class="entree" href={e.href}>
              <span class="entree-titre">{e.titre}</span>
              <span class="entree-texte">{corriger(e.texte)}</span>
              <span class="entree-action">{e.action} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="dedans" aria-labelledby="titre-anatomie">
      <h2 id="titre-anatomie">Dans chaque fiche</h2>
      <ol class="anatomie">
        {ANATOMIE.map((a) => (
          <li><span class="anatomie-titre">{a.titre}</span><span class="anatomie-texte">{corriger(a.texte)}</span></li>
        ))}
      </ol>
    </section>

    <section class="dedans" aria-labelledby="titre-domaines">
      <h2 id="titre-domaines">Tous les domaines</h2>
      {etages.map((e, i) => (
        <div class="etage" id={`etage-${e.id}`}>
          <h3><span class="etage-num">{i + 1}</span>{e.titre}</h3>
          <div class="cartes">
            {e.doms.map((d) => (
              <a class="carte" href={urlDomaine(d.id)}>
                <span class="carte-titre">{d.titre}</span>
                <span class="carte-sous">{corriger(d.sous)}</span>
                <span class="jauge" aria-hidden="true"><span style={`width:${pct(d.ecrites, d.total)}%`}></span></span>
                <span class="carte-compte">{d.ecrites} / {d.total} fiches écrites</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="bande" aria-labelledby="titre-parcours">
      <div class="dedans">
        <h2 id="titre-parcours">Les parcours</h2>
        <p class="intro">Un parcours part de ta cible et remonte tous les prérequis, puis te les donne dans le bon ordre.</p>
        <div class="cartes">
          {parcours.map((p) => {
            const faites = p.etapes.filter((id) => ecrites.has(id)).length;
            return (
              <a class="carte" href={urlParcours(p.id)}>
                <span class="carte-titre">{corriger(p.titre)}</span>
                <span class="carte-sous">{p.etapes.length} étapes</span>
                <span class="jauge" aria-hidden="true"><span style={`width:${pct(faites, p.etapes.length)}%`}></span></span>
                <span class="carte-compte">{faites} / {p.etapes.length} fiches écrites</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .dedans { max-width: var(--largeur-large); margin: 0 auto; padding: 0 var(--espace); }
  section.dedans { padding-block: 1rem; }
  .heros {
    max-width: var(--largeur-large); margin: 0 auto; padding: 3rem var(--espace) 3.5rem;
    display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center;
  }
  .surtitre { font-family: var(--police-titre); font-size: var(--t-xs); letter-spacing: .08em; text-transform: uppercase; color: var(--lagune); font-weight: 600; margin-bottom: .75rem; }
  .heros h1 { font-size: var(--t-3xl); line-height: 1.02; margin-bottom: 1rem; }
  .chapo { font-size: var(--t-m); line-height: 1.5; color: var(--encre-douce); max-width: 38ch; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1.5rem 0 1.25rem; }
  .bouton {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 1.2rem; border-radius: var(--rayon);
    font-family: var(--police-titre); font-weight: 600; text-decoration: none; border: 1.5px solid var(--indigo); color: var(--indigo);
  }
  .bouton:hover { background: var(--papier-2); }
  .bouton-plein { background: var(--indigo); color: var(--papier); }
  .bouton-plein:hover { background: var(--encre); border-color: var(--encre); }
  .bouton:focus-visible, .route a:focus-visible, .entree:focus-visible, .carte:focus-visible { outline: 2px solid var(--or); outline-offset: 3px; }
  .chiffres { font-size: var(--t-xs); color: var(--encre-douce); font-variant-numeric: tabular-nums; }
  .chiffres strong { color: var(--encre); }

  /* La route : une ligne verticale, quatre arrêts, du plus simple au plus avancé. */
  .route { list-style: none; margin: 0; padding: 0; position: relative; }
  .route::before { content: ''; position: absolute; left: 1.2rem; top: 1.5rem; bottom: 1.5rem; width: 3px; background: linear-gradient(var(--indigo), var(--lagune), var(--or)); border-radius: 2px; }
  .route li + li { margin-top: .5rem; }
  .route a {
    position: relative; display: grid; grid-template-columns: 2.4rem 1fr; column-gap: .9rem; row-gap: .1rem;
    padding: .8rem 1rem .8rem 0; text-decoration: none; color: var(--encre); border-radius: var(--rayon);
  }
  .route a:hover { background: var(--papier-2); }
  .route-num {
    grid-row: 1 / span 3; width: 2.4rem; height: 2.4rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--papier); border: 3px solid var(--indigo); font-family: var(--police-titre); font-weight: 700; color: var(--indigo); position: relative;
  }
  .route li:nth-child(2) .route-num { border-color: var(--lagune); color: var(--lagune); }
  .route li:nth-child(3) .route-num { border-color: var(--lagune); color: var(--lagune); }
  .route li:nth-child(4) .route-num { border-color: var(--or); color: var(--encre); }
  .route-titre { font-family: var(--police-titre); font-weight: 600; font-size: var(--t-m); line-height: 1.2; }
  .route-resume { font-size: var(--t-xs); color: var(--encre-douce); }
  .route-compte { font-size: var(--t-xs); color: var(--lagune); font-variant-numeric: tabular-nums; }

  .bande { background: var(--papier-2); padding-block: 1.5rem 2.5rem; margin-block: 2rem; }
  .bande h2 { margin-top: 1.5rem; }
  .intro { color: var(--encre-douce); max-width: var(--colonne); }
  .entrees { display: grid; gap: 1rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .entree {
    display: grid; gap: .5rem; align-content: start; padding: 1.25rem; background: var(--papier); border-radius: var(--rayon);
    border: 1px solid var(--trait); text-decoration: none; color: var(--encre); border-top: 4px solid var(--indigo);
  }
  .entree:nth-child(2) { border-top-color: var(--lagune); }
  .entree:nth-child(3) { border-top-color: var(--or); }
  .entree:hover { border-color: var(--encre-douce); }
  .entree-titre { font-family: var(--police-titre); font-weight: 700; font-size: var(--t-m); }
  .entree-texte { color: var(--encre-douce); line-height: 1.5; }
  .entree-action { color: var(--indigo); font-family: var(--police-titre); font-weight: 600; margin-top: .25rem; }

  .anatomie { list-style: none; counter-reset: a; padding: 0; margin: 0; display: grid; gap: 1rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .anatomie li { counter-increment: a; margin: 0; display: grid; gap: .25rem; padding-top: .75rem; border-top: 2px solid var(--trait); }
  .anatomie li::before { content: counter(a, decimal-leading-zero); font-family: var(--police-code); font-size: var(--t-xs); color: var(--lagune); }
  .anatomie-titre { font-family: var(--police-titre); font-weight: 600; }
  .anatomie-texte { font-size: var(--t-xs); color: var(--encre-douce); line-height: 1.5; }

  .etage { margin-bottom: 2.25rem; scroll-margin-top: 5rem; }
  .etage h3 { display: flex; align-items: center; gap: .6rem; }
  .etage-num { font-family: var(--police-code); font-size: var(--t-xs); color: var(--lagune); border: 1.5px solid var(--lagune); border-radius: 50%; width: 1.7rem; height: 1.7rem; display: inline-grid; place-items: center; }
  .cartes { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .carte {
    display: grid; gap: .35rem; align-content: start; padding: 1rem 1.1rem; border: 1px solid var(--trait); border-radius: var(--rayon);
    background: var(--papier); text-decoration: none; color: var(--encre);
  }
  .carte:hover { border-color: var(--indigo); }
  .carte-titre { font-family: var(--police-titre); font-weight: 600; font-size: var(--t-m); line-height: 1.2; }
  .carte-sous { font-size: var(--t-xs); color: var(--encre-douce); }
  .jauge { display: block; height: 5px; border-radius: 3px; background: var(--trait); overflow: hidden; margin-top: .4rem; }
  .jauge span { display: block; height: 100%; background: var(--lagune); }
  .carte-compte { font-size: var(--t-xs); color: var(--encre-douce); font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) {
    .heros { grid-template-columns: 1fr; padding-top: 2rem; }
    .entrees { grid-template-columns: 1fr; }
  }
  @media (max-width: 500px) {
    .heros h1 { font-size: var(--t-2xl); }
    .dedans, .heros { padding-inline: 1rem; }
  }
</style>
